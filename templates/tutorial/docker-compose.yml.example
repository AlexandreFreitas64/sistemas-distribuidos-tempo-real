# MODELO INCOMPLETO. Renomeie e adapte antes de executar.
# Substitua cada marcador <...>; não use latest nem nomes globais.
# Acrescente pelo menos outro nó ou dois clientes adequados à demonstração.
services:
  middleware:
    image: <imagem-oficial>:<versao-fixa>
    # Acrescente command/environment conforme a documentação do software.
    # Para variáveis use ${VARIAVEL:-valor-de-laboratorio} e documente o padrão.
    # Monte configurações com source relativo e read_only: true quando possível.
    volumes:
      - dados:/var/lib/<diretorio-real-do-software>
    networks:
      - laboratorio
    # Configure healthcheck com uma consulta real ao serviço.
    # Exponha somente portas necessárias, em portas altas no host.

networks:
  laboratorio:

volumes:
  dados:
